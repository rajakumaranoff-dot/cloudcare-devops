pipeline {
    agent any

    stages {
        stage('Welcome') {
            steps {
                echo 'Welcome to CloudCare CI/CD!'
            }
        }

        stage('Checkout') {
            steps {
                echo 'Preparing CloudCare source code'
            }
        }

        stage('Build') {
            steps {
                echo 'CloudCare build stage started'
            }
        }

        stage('Test') {
            steps {
                echo 'CloudCare testing stage started'
            }
        }
    }
}
